{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.invalid/schemas/contractor-site-manifest-v6.json",
  "title": "Plumber Program V7 public package manifest (6.0 transport)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_name",
    "business_type",
    "contractor_profile",
    "public_domain",
    "package_version",
    "build_date",
    "stage",
    "workflow_version",
    "system_version",
    "business_assets_version",
    "repository_package_spec",
    "design_lock_reference",
    "final_approval_reference",
    "primary_action",
    "pages",
    "legacy_routes",
    "icons",
    "external_media",
    "public_documents",
    "forms"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "6.0"},
    "site_name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": ".*\\S.*"},
    "business_type": {
      "type": "string",
      "enum": [
        "contractor",
        "general-contractor",
        "plumber",
        "electrician",
        "hvac",
        "welder-metal-fabricator",
        "landscaping-lawn-care",
        "roofing",
        "painting",
        "handyman-maintenance",
        "concrete-masonry",
        "cleaning-restoration",
        "pest-control",
        "pool-spa-service",
        "moving-service",
        "other-contractor-service"
      ]
    },
    "contractor_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_categories",
        "operating_model",
        "address_publication",
        "lead_actions",
        "emergency_service",
        "proof_types"
      ],
      "properties": {
        "trade_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "plumbing",
              "electrical",
              "hvac",
              "welding-metalwork",
              "landscaping-lawn-care",
              "general-contracting-remodeling",
              "roofing",
              "painting",
              "handyman-maintenance",
              "concrete-masonry",
              "cleaning-restoration",
              "pest-control",
              "pool-spa-service",
              "moving-service",
              "other-contractor-service"
            ]
          }
        },
        "operating_model": {
          "type": "string",
          "enum": ["service-area", "fixed-location", "hybrid", "not-confirmed"]
        },
        "address_publication": {
          "type": "string",
          "enum": ["approved-public-address", "service-area-only", "not-confirmed"]
        },
        "lead_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["call", "request-estimate", "email", "booking"]}
        },
        "emergency_service": {
          "type": "string",
          "enum": ["confirmed", "not-offered", "not-confirmed"]
        },
        "proof_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["license", "insurance", "certification", "sourced-review", "project-media", "warranty", "financing"]
          }
        }
      }
    },
    "public_domain": {"type": "string", "format": "https-origin", "maxLength": 255},
    "package_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
    },
    "build_date": {"type": "string", "format": "date-time", "maxLength": 40},
    "stage": {"type": "string", "enum": ["starter", "production"]},
    "workflow_version": {"type": "string", "pattern": "6\\.0(?:\\.[0-9]+)?", "maxLength": 16},
    "system_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
    },
    "business_assets_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
    },
    "repository_package_spec": {"type": "string", "const": "6.0"},
    "design_lock_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*"
    },
    "final_approval_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*"
    },
    "primary_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": ".*\\S.*"},
        "url": {"type": "string", "format": "action-url", "maxLength": 2048}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_path", "url_path", "canonical_url_path", "title", "purpose", "indexable"],
        "properties": {
          "file_path": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "url_path": {"type": "string", "format": "site-url-path", "maxLength": 255},
          "canonical_url_path": {"type": "string", "format": "site-url-path", "maxLength": 255},
          "title": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": ".*\\S.*"},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": ".*\\S.*"},
          "indexable": {"type": "boolean"}
        }
      }
    },
    "legacy_routes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_url_path", "handling", "destination_url_path", "purpose", "owner_approved"],
        "properties": {
          "source_url_path": {"type": "string", "format": "site-url-path", "maxLength": 255},
          "handling": {"type": "string", "enum": ["rebuild-same-url", "permanent-redirect"]},
          "destination_url_path": {"type": "string", "format": "site-url-path", "maxLength": 255},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": ".*\\S.*"},
          "owner_approved": {"type": "boolean"}
        }
      }
    },
    "icons": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "file_path", "mime_type", "sizes"],
        "properties": {
          "rel": {"type": "string", "enum": ["icon", "apple-touch-icon", "manifest", "app-icon"]},
          "file_path": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "mime_type": {"type": "string", "enum": ["image/x-icon", "image/png", "image/svg+xml", "application/manifest+json"]},
          "sizes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "(?:any|[1-9][0-9]{0,3}x[1-9][0-9]{0,3})", "maxLength": 12}
          }
        }
      }
    },
    "external_media": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "url", "page", "purpose", "accessibility", "owner_approved"],
        "properties": {
          "id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]*", "maxLength": 64},
          "kind": {
            "type": "string",
            "enum": ["direct-video", "cloudflare-stream", "youtube", "vimeo", "large-download"]
          },
          "url": {"type": "string", "format": "https-url", "maxLength": 2048},
          "page": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": ".*\\S.*"},
          "poster": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "accessibility": {"type": "string", "minLength": 1, "maxLength": 400, "pattern": ".*\\S.*"},
          "owner_approved": {"type": "boolean"}
        }
      }
    },
    "public_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "page", "purpose", "owner_approved"],
        "properties": {
          "id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]*", "maxLength": 64},
          "path": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "page": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": ".*\\S.*"},
          "owner_approved": {"type": "boolean"}
        }
      }
    },
    "forms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "action", "page", "purpose", "fallback", "privacy_page", "turnstile_action"],
        "properties": {
          "id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]*", "maxLength": 64},
          "enabled": {"type": "boolean"},
          "action": {"type": "string", "const": "/api/contact"},
          "page": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*"},
          "fallback": {"type": "string", "format": "action-url", "maxLength": 2048},
          "privacy_page": {"type": "string", "format": "relative-site-path", "maxLength": 255},
          "turnstile_action": {
            "type": "string",
            "pattern": "[A-Za-z0-9_-]+",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    }
  }
}
